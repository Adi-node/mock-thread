{
    "$schema": "https://turbo.build/repo/docs/schema.json",
    "tasks": {
        "build": {
        "dependsOn": ["^build"],
        "outputs": [".next/**", "!.next/cache/**", "dist/**"]
        },
        "dev": {
        "cache": false,
        "persistent": true
        },
        "typecheck": {
        "dependsOn": ["^build"],
        "outputs": []
        },
        "test": {},
        "lint": {}
    }
}